[Unit]
Description=Neo Control PHN16-71 firmware driver
After=systemd-modules-load.service
Before=display-manager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/neo-control/load-driver.sh
ExecStart=/opt/neo-control/set-permissions.sh
ExecStop=/opt/neo-control/restore-auto.sh

[Install]
WantedBy=multi-user.target
